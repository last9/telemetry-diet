{
  "name": "telemetry-diet",
  "version": "0.2.0",
  "description": "Local, read-only observability workbench for reviewable telemetry reduction drafts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/last9/telemetry-diet.git"
  },
  "homepage": "https://github.com/last9/telemetry-diet#readme",
  "bugs": {
    "url": "https://github.com/last9/telemetry-diet/issues"
  },
  "author": "Last9 <hello@last9.io> (https://last9.io)",
  "type": "module",
  "bin": {
    "telemetry-diet": "bin/telemetry-diet.js",
    "telemetry-diet-sample-mcp": "bin/sample-mcp.js"
  },
  "files": [
    "bin",
    "schemas",
    "scripts",
    "src",
    "web",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node bin/telemetry-diet.js --no-open",
    "dev": "node --watch bin/telemetry-diet.js --no-open",
    "sample:mcp": "node bin/sample-mcp.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85",
    "validate:artifacts": "node scripts/validate-artifacts.js",
    "format:check": "node scripts/check-text-format.js",
    "links:check": "node scripts/check-markdown-links.js",
    "licenses:check": "node scripts/check-licenses.js",
    "lint": "eslint .",
    "syntax:check": "node scripts/check-syntax.js",
    "check": "npm run format:check && npm run links:check && npm run lint && npm run syntax:check",
    "pack:check": "node scripts/check-package.js",
    "release:check": "node scripts/check-release.js",
    "verify": "npm run check && npm run test:coverage && npm run licenses:check && npm run pack:check",
    "prepublishOnly": "npm run verify && npm run release:check"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "observability",
    "opentelemetry",
    "logs",
    "metrics",
    "traces",
    "promql",
    "datadog",
    "last9"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prometheus-io/lezer-promql": "0.313.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.9.0"
  }
}
